# =============================================================================
# Manga Tracker — root environment template (Flask desktop app + utils scripts)
#
# Copy this file to `.env` in the project root and fill in the values.
# `.env` is git-ignored. This example file is committed, so NEVER put real
# keys or passwords here.
#
# Account passwords (Supabase dashboard login, database password, GitHub,
# Expo) do NOT belong in any env file. Keep them in a password manager.
# Note: this project folder lives inside OneDrive, so every file in it,
# including `.env`, is synced to Microsoft's cloud.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project URL: Supabase dashboard > Project Settings > Data API > Project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (starts with sb_publishable_). Public by design: the
# row-level-security policies are the real access boundary.
# Dashboard > Project Settings > API Keys > Publishable key
# Used by: manga_tracker_app.py (via cloud_database.py) for sign-in and sync.
SUPABASE_KEY=sb_publishable_<your-publishable-key>

# OPTIONAL secret key (starts with sb_secret_). SECRET: it bypasses
# row-level security. Only utils/upload_scrapers.py uses it, to write
# scraper_configs (the publishable key has no write access to that table).
# Leave it empty unless you run that script. Never copy it into
# mobile_app/.env or any EXPO_PUBLIC_ variable.
# Dashboard > Project Settings > API Keys > Secret keys
SUPABASE_SECRET_KEY=

# --- Flask desktop app -------------------------------------------------------
# Local port for manga_tracker_app.py. Default is 59021.
# Supabase email/OAuth confirmation redirects to
# http://127.0.0.1:59021/auth/confirm (hardcoded in cloud_database.py), so
# changing this port also breaks that redirect unless the code is updated.
MANGA_PORT=59021

# =============================================================================
# Reference links (not secrets; nothing below is read by the code)
#
# Supabase dashboard:      https://supabase.com/dashboard/project/<project-ref>
#   API keys:              https://supabase.com/dashboard/project/<project-ref>/settings/api-keys
#   Auth redirect URLs:    https://supabase.com/dashboard/project/<project-ref>/auth/url-configuration
#   Table editor:          https://supabase.com/dashboard/project/<project-ref>/editor
#
# Auth redirect URLs that must be allowed in Supabase Auth settings:
#   mobile app:            mangatracker://redirect
#   Flask desktop app:     http://127.0.0.1:59021/auth/confirm
#
# Supabase tables used:    manga_library, profiles, scraper_configs
#
# Scraper sites (configs in scrapers/*.json, mirrored to scraper_configs):
#   https://asurascans.com
#   https://toonily.com
#   https://mangaclash.com
#   https://www.mangaread.org
#   https://manhuatop.org
#   https://kingofshojo.com
#   https://gourmetsupremacy.com
#   https://arenascan.com
#   https://www.webtoons.com
# =============================================================================
