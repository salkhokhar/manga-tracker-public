{
  "name": "Webtoons",
  "theme": "custom",
  "rating_scale": 10,
  "requires_proxy": true,
  "search_url": "https://www.webtoons.com/en/search?keyword={query}",
  "selectors": {
    "explore": {
      "item": "ul.webtoon_list li, .card_lst li, .lst_type1 li, .ranking_lst li, #_searchList li",
      "title": ".title, .subj, .ellipsis",
      "link": "a",
      "image": "img",
      "image_attr": "src"
    },
    "details": {
      "title": ".subj",
      "author": ".author",
      "desc": ".summary",
      "image": ".detail_header .info img",
      "genre": ".genre",
      "rating": "#_starScoreAverage",
      "meta_container": ".day_info",
      "meta_key": "self",
      "meta_val": "self"
    },
    "chapters": {
      "item": "#_listUl li",
      "link": "a",
      "title": ".subj span",
      "date": ".date"
    },
    "images": {
      "item": "#_imageList img",
      "src_attr": "data-url, src"
    }
  },
