# =============================================================================
# Manga Tracker — mobile app (Expo) environment template
#
# Copy this file to `mobile_app/.env` and fill in the values. `.env` is
# git-ignored; this example file is committed, so never put real values here.
#
# WARNING: every EXPO_PUBLIC_ variable is built into the app bundle and can be
# read by anyone who installs it. Only public values belong in this file.
# NEVER put the Supabase secret key (sb_secret_...) or any password here.
#
# Both values are optional: services/supabase.ts falls back to the built-in
# production project when they are unset. Set them to point a dev build at a
# different (for example staging) Supabase project.
# =============================================================================

# Supabase dashboard > Project Settings > Data API > Project URL
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase dashboard > Project Settings > API Keys > Publishable key
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<your-publishable-key>
